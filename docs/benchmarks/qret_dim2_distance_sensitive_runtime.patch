+Beat DistanceSensitivePathLatencyFactor() {
+    static const auto factor = [] {
+        const auto* text =
+                std::getenv("QRET_SC_LS_PATH_LATENCY_PER_ADDITIONAL_COORDINATE");
+        if (text == nullptr || *text == '\0') {
+            return Beat{0};
+        }
+
+        errno = 0;
+        auto* end = static_cast<char*>(nullptr);
+        const auto value = std::strtoull(text, &end, 10);
+        if (errno != 0 || end == text || *end != '\0'
+            || value > std::numeric_limits<Beat>::max()) {
+            throw std::invalid_argument(
+                    "QRET_SC_LS_PATH_LATENCY_PER_ADDITIONAL_COORDINATE must be a non-negative integer"
+            );
+        }
+        return static_cast<Beat>(value);
+    }();
+    return factor;
+}
+
+Beat DistanceSensitivePathLatency(Beat base_latency, std::size_t path_coordinates) {
+    const auto factor = DistanceSensitivePathLatencyFactor();
+    const auto additional_coordinates = path_coordinates > 1 ? path_coordinates - 1 : 0;
+    if (factor != 0
+        && additional_coordinates
+                > (std::numeric_limits<Beat>::max() - base_latency) / factor) {
+        throw std::overflow_error("distance-sensitive path latency overflow");
+    }
+    return base_latency + factor * static_cast<Beat>(additional_coordinates);
+}
