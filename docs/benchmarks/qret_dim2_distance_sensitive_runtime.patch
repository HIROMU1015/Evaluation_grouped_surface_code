+
+bool ExtendedPathDurationIsAvailable(
+        QuantumStateBuffer& buffer,
+        Beat beat,
+        Beat base_latency,
+        const ScLsInstructionBase& inst
+) {
+    for (auto b = beat + base_latency; b < beat + inst.Latency(); ++b) {
+        auto& state = buffer.GetQuantumState(b);
+        for (const auto& coord : inst.Ancilla()) {
+            auto& plane = state.GetGrid(coord.z).GetPlane(coord.z);
+            if (!plane.GetNode(coord.XY()).IsFreeAncilla()) {
+                return false;
+            }
+        }
+        for (const auto q : inst.QTarget()) {
+            const auto& place = state.GetPlace(q);
+            auto& plane = state.GetGrid(place.z).GetPlane(place.z);
+            if (!plane.GetNode(place.XY()).is_available) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
