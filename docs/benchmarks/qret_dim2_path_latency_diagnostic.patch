+Beat DiagnosticPathLatencyFactor() {
+    const char* text =
+            std::getenv("QRET_SC_LS_PATH_LATENCY_PER_ADDITIONAL_COORDINATE");
+    if (text == nullptr || *text == '\0') {
+        return 0;
+    }
+    char* end = nullptr;
+    const auto value = std::strtoull(text, &end, 10);
+    return end != text && *end == '\0' ? static_cast<Beat>(value) : Beat{0};
+}
+
+void CalculateDiagnosticPathLatencyDepth(
+        const MachineFunction& mf,
+        ScLsFixedV0CompileInfo& compile_info
+) {
+    const auto factor = DiagnosticPathLatencyFactor();
+    auto graph = DepGraph(mf);
+    auto id = DepGraph::IdType{0};
+    auto added_weight = std::uint64_t{0};
+    for (const auto& bb : mf) {
+        for (const auto& minst : bb) {
+            const auto& inst = *static_cast<const ScLsInstructionBase*>(minst.get());
+            const auto path_size = inst.Ancilla().size();
+            const auto additional_coordinates = path_size > 1 ? path_size - 1 : 0;
+            const auto additional_weight = factor * additional_coordinates;
+            graph.SetNodeWeight(id, inst.Latency() + additional_weight);
+            added_weight += additional_weight;
+            ++id;
+        }
+    }
+    compile_info.diagnostic_path_latency_factor = factor;
+    compile_info.diagnostic_path_latency_dependency_depth = graph.CalcHeaviest();
+    compile_info.diagnostic_path_latency_added_weight = added_weight;
+}
+
